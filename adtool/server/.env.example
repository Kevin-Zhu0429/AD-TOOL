# 复制成 .env 使用。.env 不要提交到 git。

PORT=8080

# 数据目录:数据库和备份都在这。搬到 NAS 时只改这一行
# Windows 例:DATA_DIR=D:/adtool-data
DATA_DIR=./data

# session 加密盐,随便一串长字符,改掉默认值
SESSION_SECRET=换成你自己的一串随机字符串

# 后台线程数:不填 = CPU 核数减 1(最多 4);填 0 = 所有查询回到主线程执行
# WORKER_POOL_SIZE=4

# ---------- 亚马逊 SP-API 库存同步 ----------
# 每个品牌一组,编号 BRAND1、BRAND2 … 往下排(编号不必连续)。
#   NAME            品牌名,要和 SKU 库里的「品牌」一致
#   MARKETS         读取店铺时列出哪些站点,逗号分隔;不填 = 账号开通的全部站点
#   LWA_CLIENT_ID / LWA_CLIENT_SECRET   这个品牌开发者应用的凭证
#   LWA_REFRESH_TOKEN_EU + SELLER_ID_EU  欧洲账号(ES / DE / FR / IT / UK)
#   LWA_REFRESH_TOKEN_NA + SELLER_ID_NA  北美账号(US / CA)
#   LWA_REFRESH_TOKEN_AE + SELLER_ID_AE  中东账号(AE)
#   LWA_REFRESH_TOKEN_AU + SELLER_ID_AU  澳洲账号(AU,亚马逊叫远东区,后缀写 _FE 也认)
# 没有的账号整行不写。填得不完整的,账号管理 → 亚马逊库存 页面会提示缺哪一项。
BRAND1_NAME=CC
BRAND1_MARKETS=ES,DE,FR,IT,UK,US,CA
BRAND1_LWA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
BRAND1_LWA_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
BRAND1_LWA_REFRESH_TOKEN_EU=Atzr|xxxxxxxx
BRAND1_SELLER_ID_EU=A1XXXXXXXXXXXX
BRAND1_LWA_REFRESH_TOKEN_NA=Atzr|yyyyyyyy
BRAND1_SELLER_ID_NA=A2YYYYYYYYYYYY

# BRAND2_NAME=CE
# BRAND2_MARKETS=ES,DE,FR,IT,UK
# BRAND2_LWA_CLIENT_ID=…
# BRAND2_LWA_CLIENT_SECRET=…
# BRAND2_LWA_REFRESH_TOKEN_EU=…
# BRAND2_SELLER_ID_EU=…

# ---------- Listing 管理(内测,只有超级管理员看得到) ----------
# 不填或不是 true:页面上的「上传」只让亚马逊校验(VALIDATION_PREVIEW),不会改线上 Listing。
# 确认要真正改 Listing 时再设成 true。开发人员拉取、编辑需要开发者应用勾选「商品发布 (Product Listing)」角色。
# LISTINGS_LIVE_SUBMIT=true
