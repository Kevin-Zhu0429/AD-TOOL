# 复制成 .env 使用。.env 不要提交到 git。

PORT=8080

# 数据目录:数据库和备份都在这。搬到 NAS 时只改这一行
# Windows 例:DATA_DIR=D:/adtool-data
DATA_DIR=./data

# session 加密盐,随便一串长字符,改掉默认值
SESSION_SECRET=换成你自己的一串随机字符串

# 后台线程数:不填 = CPU 核数减 1(最多 4);填 0 = 所有查询回到主线程执行
# WORKER_POOL_SIZE=4

# ---------- 亚马逊 SP-API 库存同步 ----------
# 开发者应用的 LWA 凭证(卖家后台 → 应用和服务 → 开发应用 → 查看凭证)
SPAPI_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
SPAPI_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxx
# 卖家授权应用后拿到的 Refresh Token(Atzr| 开头)和卖家编号(Merchant Token)
SPAPI_REFRESH_TOKEN=Atzr|xxxxxxxx
SPAPI_SELLER_ID=A1XXXXXXXXXXXX
# 店铺名:建议填 SKU 库里的品牌(比如 CY),读取店铺时会自动选中这个品牌。不填就显示卖家编号
SPAPI_STORE_NAME=CY
# 接口区域:eu(欧洲 / 英国 / 阿联酋)、na(美国 / 加拿大)、fe(澳洲)。不填会自动识别
# SPAPI_REGION=eu
#
# 还有别的卖家账号(同一个开发者应用授权的),在变量名后面加 _2、_3 …,例如:
# SPAPI_REFRESH_TOKEN_2=Atzr|yyyyyyyy
# SPAPI_SELLER_ID_2=A2YYYYYYYYYYYY
# SPAPI_STORE_NAME_2=PG
# 同一个卖家编号在欧洲和美国各有一个 Refresh Token 时,两个都要填 SPAPI_REGION
