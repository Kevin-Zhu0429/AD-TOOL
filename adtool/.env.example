# 复制成 .env 放在 adtool/ 目录下,docker compose 会自动读。.env 不要提交到 git。

# 对外端口。想直接用 80 就写 80(容器内部固定 8080,不用动)
HOST_PORT=8080

# session 加密盐。必须改!随便生成一串:openssl rand -hex 32
SESSION_SECRET=

# 容器时区,影响日志和数据库里的时间戳
TZ=Asia/Shanghai

# 容器内进程用哪个 uid/gid 运行。必须和 data-prod 目录的属主一致,
# 否则容器写不了数据库。在服务器上跑 `id -u` 和 `id -g` 取值
APP_UID=1000
APP_GID=1000

# ---- 只在构建拉不动的时候才需要改 ----
# Docker Hub 被墙/DNS 污染时,换成加速器地址,例如:
#   NODE_IMAGE=docker.m.daocloud.io/library/node:22-bookworm-slim
NODE_IMAGE=node:22-bookworm-slim

# npm 源。国内建议换成 https://registry.npmmirror.com,构建快很多
NPM_REGISTRY=https://registry.npmjs.org

# Debian 源。官方源在国内拉不动会导致编译工具链装不上,进而 better-sqlite3 编译失败。
# 先测再填(见 DEPLOY.md 第五节),例如:
#   DEBIAN_MIRROR=http://mirrors.aliyun.com
DEBIAN_MIRROR=

# node-gyp 下 Node 头文件的地址(通过 npm_config_disturl 传给 node-gyp)。
# nodejs.org 能连上就可以留空;慢的话换成:
#   NODE_DISTURL=https://cdn.npmmirror.com/binaries/node
NODE_DISTURL=
