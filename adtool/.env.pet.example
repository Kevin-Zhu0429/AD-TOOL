PET_HOST_PORT=8081
# Fill a new long random value. Do not reuse the ink deployment's session secret.
PET_SESSION_SECRET=
APP_UID=1000
APP_GID=1000
TZ=Asia/Shanghai
# This compose file expects an HTTPS reverse proxy on the host.
TRUST_PROXY=true
COOKIE_SECURE=true
# Amazon SP-API for the pet seller account (North America). Never commit real values.
PET_SP_LWA_CLIENT_ID=
PET_SP_LWA_CLIENT_SECRET=
PET_SP_LWA_REFRESH_TOKEN=
PET_SP_SELLER_ID=
# Optional: brand written onto SKUs that the sync adds to the SKU library
PET_SP_BRAND=
# Claude connector (MCP): the site's public https address, e.g. https://example.com. Empty = connector off.
MCP_PUBLIC_URL=
